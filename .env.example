# Copy this file to .env and fill in real values.
# .env is gitignored — keep secrets out of source control.

# Apollo.io
APOLLO_API_KEY=

# Instantly.ai
INSTANTLY_API_KEY=
INSTANTLY_CAMPAIGN_ID=

# Inframail
INFRAMAIL_API_KEY=
INFRAMAIL_CUSTOMER_ID=
INFRAMAIL_PROFILE_ID=
INFRAMAIL_HOST_ORDER_ID=

# Optional
TARGET_LOCATION=United States
LEAD_AGENT_LOG_DIR=/opt/lead_agent/logs
LEAD_AGENT_LOG_FILE=/opt/lead_agent/logs/with_campaign_assignment.log
DASHBOARD_PORT=8080
